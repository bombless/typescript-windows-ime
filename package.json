{
  "name": "typescript-windows-ime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows TSF IME with a thin native adapter and a TypeScript logic core.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "host": "powershell -NoProfile -ExecutionPolicy Bypass -File native\\install-host.ps1",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "install": "^0.13.0",
    "opencc-js": "^1.4.2"
  }
}
